# =============================================================================
# Supabase PostgreSQL — lấy tại: Supabase Dashboard > Project > Connect (nút "Connect" trên thanh trên cùng)
# Thay [YOUR-PASSWORD] và [PROJECT-REF] / [REGION] bằng giá trị thật.
# Nếu mật khẩu có ký tự đặc biệt (@ # / : ?), hãy URL-encode (VD: @ -> %40).
# =============================================================================

# 1) Transaction Pooler (port 6543) — dùng cho RUNTIME của ứng dụng (Next.js / Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2) Session Pooler / Direct (port 5432) — dùng cho Prisma CLI (db push, migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
